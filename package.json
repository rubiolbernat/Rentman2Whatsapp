{
  "name": "rentman-whatsapp-desktop",
  "version": "1.0.3",
  "description": "App d'escriptori (Electron) per crear i gestionar grups de WhatsApp a partir de projectes de Rentman.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux",
    "publish:win": "dotenv -e .env -- electron-builder --win --publish always",
    "publish:mac": "dotenv -e .env -- electron-builder --mac --publish always",
    "publish:linux": "dotenv -e .env -- electron-builder --linux --publish always"
  },
  "dependencies": {
    "whatsapp-web.js": "^1.34.7",
    "qrcode": "^1.5.4",
    "express": "^4.19.2",
    "cors": "^2.8.5",
    "electron-updater": "^6.8.9",
    "electron-log": "^5.4.4"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "dotenv-cli": "^11.0.0"
  },
  "build": {
    "appId": "com.example.rentmanwhatsapp",
    "productName": "Rentman WhatsApp",
    "asar": false,
    "icon": "build/icon.png",
    "files": [
      "main.js",
      "preload.js",
      "backend/**/*",
      "renderer/**/*",
      "node_modules/**/*",
      ".puppeteer-cache/**/*",
      "package.json"
    ],
    "win": { "target": "nsis" },
    "mac": { "target": "dmg" },
    "linux": { "target": "AppImage" },
    "publish": {
      "provider": "github",
      "owner": "rubiolbernat",
      "repo": "Rentman2Whatsapp"
    }
  }
}